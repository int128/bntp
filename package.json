    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "4.1.12",
    "jsdom": "29.1.1",
    "playwright": "1.65.1",
    "pnpm": "12.21.0",
